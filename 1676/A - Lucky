#include <bits/stdc++.h>
using namespace std;
 
int cv(char ch){
  return ch-'0';
}
 
int main(){
  int t;
  cin >> t;
  while(t--){
    string s;
    cin >> s;
    if ((cv(s[0])+cv(s[1])+cv(s[2]))==(cv(s[3])+cv(s[4])+cv(s[5]))){
      cout << "YES" << endl;
    }
    else{
      cout << "NO" << endl;
    }
  }
}