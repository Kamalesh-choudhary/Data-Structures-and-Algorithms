#include <bits/stdc++.h>
using namespace std;
 
int main(){
  int t;
  cin >> t;
  while (t--){
    string s;
    cin >> s;
    if ((s.size()&1)!=0){
      cout << "no" << endl;
      continue;
    }
    int half = s.size()/2;
    if (s.substr(0,half)==s.substr(half)){
      cout << "yes" << endl;
    }
    else{
      cout << "no" << endl;
    }
  }
}