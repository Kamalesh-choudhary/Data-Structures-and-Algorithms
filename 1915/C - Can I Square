#include <bits/stdc++.h>
using namespace std;
 
int main(){
  int t;
  cin >> t;
  while(t--){
    int n;
    cin >> n;
    vector<int> ar(n);
    long long total = 0;
    for (auto &x:ar){
      cin >> x;
      total += x;
    }
    long long side = sqrt(total);
    if ((side * side )== total){
      cout << "YES" << endl;
    }
    else{
      cout << "NO" << endl;
    }
  }
}