use std::io;
use std::collections::HashSet;
fn main(){
    let mut input = String::new();
    io::stdin().read_line(&mut input).unwrap();
    let ar: Vec<i32> = input.split_whitespace().map(|x| x.parse().unwrap()).collect();
    let set: HashSet<i32> = ar.into_iter().collect();
    if set.len() > 4{
        println!("{}",0);
    }
    else{
        println!("{}",4-set.len());
    }
}